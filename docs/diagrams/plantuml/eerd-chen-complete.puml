  MeetingRoomId
  Status
  CancellationReason
  IsNoShowStudent
  IsNoShowConsultant
}
entity NO_SHOW_REPORT {
  Id <<key>>
  AccusedRole
  Status
  ResolvedAt
  AdminNote
  ReporterNote
}
entity CONSULTANT_REVIEW {
  Id <<key>>
  Rating
  Comment
  IsHiddenByAdmin
}
entity SESSION_RECORDING {
  Id <<key>>
  RecordingId
  StoragePath
  ContentType
  RecordedAt
}

' ---------------------------------------------------------------------
' ZONE 4 — Community & Chat
' ---------------------------------------------------------------------
entity "USER" as USER_COM {
  Id <<key>>
}
entity FORUM_CATEGORY {
  Id <<key>>
  Slug
  NameEn
  NameAr
  DisplayOrder
  IsActive
}
entity FORUM_POST {
  Id <<key>>
  BodyMarkdown
  ModerationStatus
  UpvoteCount <<derived>>
  DownvoteCount <<derived>>
  FlagCount <<derived>>
  ReplyCount <<derived>>
