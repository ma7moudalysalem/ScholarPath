' =====================================================================
'  ScholarPath — COMPLETE Conceptual EERD, single diagram (Chen / Elmasri notation)
'  Follows Elmasri & Navathe Fig. 3.14:
'     rectangle = entity type       diamond = relationship type
'     oval      = attribute         underlined oval = key attribute
'     double oval <<multi>>         = multivalued attribute
'     dashed oval <<derived>>       = derived / computed attribute
'     double line (=) = TOTAL participation     single line (-) = partial
'     1 / N            = cardinality ratio on each relationship edge
'  All entities are STRONG (own surrogate Guid Id); existence-dependence of
'  detail/child rows is expressed through TOTAL participation, not weak-entity
'  double-rectangles (same decision as the per-area Chen diagrams).
'
'  SCOPE — verified against the live EF Core model 2026-07-05
'  (server/src/ScholarPath.Domain/Entities/*.cs + the EF Core migration
'  snapshot). Covers every non-payment persistent entity in the system.
'
'  DELIBERATELY EXCLUDED (product decision — payments are hidden end-to-end
'  while the platform runs in free mode; see docs/diagrams/01-EERD.md §6 for
'  the full payment-area EERD kept for reference):
'    - Entities: Payment, Payout, StripeWebhookEvent, ProfitShareConfig,
'      FinancialConfigRule, ScholarshipProviderReviewPayment (legacy/dead).
'    - Relationships/FKs into the above from Booking and from
'      ScholarshipProviderReviewRequest (both had a nullable PaymentId FK).
'    - Every monetary attribute that only exists to price/settle those
'      payment flows: Booking.PriceUsd, Booking.StripePaymentIntentId,
'      UserProfile.SessionFeeUsd, UserProfile.StripeConnect*,
'      Scholarship.ReviewFeeUsd, ScholarshipProviderReviewRequest.
'      ReviewFeeUsdSnapshot/Currency.
'    - KEPT: Scholarship.FundingAmountUsd — this is the external award value
'      the scholarship itself grants a student; it is descriptive scholarship
'      data, not a figure ScholarPath charges or processes, so it stays.
'
'  ATTRIBUTE SCOPE: to stay legible at this size, every entity also carries
'  (and this diagram omits) the framework columns CreatedAt, UpdatedAt,
'  RowVersion and — where the entity is soft-deletable — IsDeleted/DeletedAt/
'  DeletedByUserId. Only Id (the surrogate key) and business/domain
'  attributes are drawn. Foreign keys are conveyed by the relationship
'  diamonds, not repeated as attribute ovals (authentic Chen practice).
' =====================================================================
@startchen EERD_Complete

' ---------------------------------------------------------------------
' ZONE 1 — Identity, Access & Profile
' ---------------------------------------------------------------------
entity USER {
  Id <<key>>
  Email
  FirstName
  LastName
  AccountStatus
  ActiveRole
  IsOnboardingComplete
  PreferredLanguage
  CountryOfResidence
  LastLoginAt
}
entity ROLE {
  Id <<key>>
  Name
  Description
}
entity USER_PROFILE {
  Id <<key>>
  Biography
  DateOfBirth
  Nationality
  AcademicLevel
  FieldOfStudy
  Gpa
  PreferredCountries <<multi>>
  PreferredFields <<multi>>
  BookingAccessStatus
  BookingBlockReason
  BookingBlockUntil
  OrganizationLegalName
  OrganizationVerificationStatus
  ScholarshipProviderType
  ScholarshipProviderAverageRating <<derived>>
  ScholarshipProviderReviewCount <<derived>>
  ProfessionalTitle
  FieldOfExpertise
  YearsOfExperience
  ExpertiseTags <<multi>>
  Languages <<multi>>
  SessionDurationMinutes
  ConsultantAverageRating <<derived>>
  ConsultantReviewCount <<derived>>
  ConsultantRatingPenaltyFactor <<derived>>
  ProfileCompletenessPercent <<derived>>
}
entity EDUCATION_ENTRY {
  Id <<key>>
  InstitutionName
  Degree
  FieldOfStudy
  StartDate
  EndDate
  Gpa
}
entity EXPERTISE_TAG {
  Id <<key>>
  Slug
  NameEn
  NameAr
  Category
}
entity REFRESH_TOKEN {
  Id <<key>>
  TokenHash
  ExpiresAt
  IsRevoked
  RevokedAt
}
entity PASSWORD_RESET_TOKEN {
  Id <<key>>
  TokenHash
  ExpiresAt
  UsedAt
}
entity LOGIN_ATTEMPT {
  Id <<key>>
  Email
  Succeeded
  FailureReason
  OccurredAt
}
entity UPGRADE_REQUEST {
  Id <<key>>
  Target
  Status
  Reason
  ReviewerNotes
  ReviewedAt
}
entity UPGRADE_REQUEST_FILE {
  Id <<key>>
  FileName
  BlobUrl
}
entity UPGRADE_REQUEST_LINK {
  Id <<key>>
  Label
  Url
}

' ---------------------------------------------------------------------
' ZONE 2 — Scholarships, Applications & Documents
' ---------------------------------------------------------------------
' NOTE ON THE 5 STUB BOXES BELOW (USER_SCH / USER_BK / USER_COM / USER_RES /
' USER_AI): USER is a hub entity connected across every zone. Drawing all ~30
' of its relationships into ONE box collapses the whole poster into a single
' unreadable row (verified while laying this out). Instead the SAME physical
' USER / Users table is repeated once per zone as an empty reference box —
' full attributes are drawn only once, in Zone 1. This is a layout device
' only; it does not add a table or change any relationship semantics.
entity "USER" as USER_SCH {
  Id <<key>>
}
entity CATEGORY {
  Id <<key>>
  Slug
  NameEn
  NameAr
  DisplayOrder
}
entity SCHOLARSHIP {
  Id <<key>>
  Slug
  TitleEn
  TitleAr
  Mode
  Status
  Deadline
  FundingType
  FundingAmountUsd
  TargetLevel
  IsFeatured
}
entity SCHOLARSHIP_CHILD {
  Id <<key>>
  ChildType
  KeyEn
  ValueEn
  SortOrder
}
entity SAVED_SCHOLARSHIP {
  Id <<key>>
  SavedAt
  Note
}
entity APPLICATION {
  Id <<key>>
  Status
  Mode
  SubmittedAt
  DecisionAt
  PersonalNotes
  ExternalTitle
  ExternalProvider
}
entity APPLICATION_CHILD {
  Id <<key>>
  ChildType
  Title
  Content
  OccurredAt
}
entity DOCUMENT {
  Id <<key>>
  FileName
  Category
  StoragePath
  UploadedAt
}
entity SCHOLARSHIP_PROVIDER_REVIEW {
  Id <<key>>
  Rating
  Comment
  IsHiddenByAdmin
}
entity SCHOLARSHIP_PROVIDER_REVIEW_REQUEST {
  Id <<key>>
  Status
  SubmittedAt
  CompletedAt
}

' ---------------------------------------------------------------------
' ZONE 3 — Consultant Booking & Ratings
' ---------------------------------------------------------------------
entity "USER" as USER_BK {
  Id <<key>>
}
entity AVAILABILITY {
  Id <<key>>
  DayOfWeek
  StartTime
  EndTime
  Timezone
  IsRecurring
  IsActive
}
entity BOOKING {
  Id <<key>>
  ScheduledStartAt
  ScheduledEndAt
