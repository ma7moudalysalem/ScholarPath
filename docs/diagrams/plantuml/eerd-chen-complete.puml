HAS_DETAIL =N= SCHOLARSHIP_CHILD
USER_SCH -1- SAVES
SAVES -N- SAVED_SCHOLARSHIP
SCHOLARSHIP -1- SAVES_SCH
SAVES_SCH =N= SAVED_SCHOLARSHIP
USER_SCH -1- SUBMITS
