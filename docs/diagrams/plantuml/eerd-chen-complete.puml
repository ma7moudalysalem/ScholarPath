RESERVES -N- BOOKING
BOOKING -1- REPORTED_IN
REPORTED_IN =N= NO_SHOW_REPORT
USER_BK -1- FILES_REPORT
FILES_REPORT =N= NO_SHOW_REPORT
USER_BK -1- ACCUSED_IN
