  ContentHash
  EmbeddingDimensions
}
entity PLATFORM_SETTING {
  Id <<key>>
  SettingKey
  Value
  ValueType
  Category
}
entity SUCCESS_STORY {
  Id <<key>>
  AuthorDisplayName
  HeadlineEn
  IsApproved
  IsFeatured
}
entity USER_RISK_FLAG {
  Id <<key>>
  Score <<derived>>
  IsAtRisk
  Reason
  ComputedAt
}
entity AUDIT_LOG {
  Id <<key>>
  Action
  TargetType
  OccurredAt
  Summary
}
entity USER_DATA_REQUEST {
  Id <<key>>
  Type
  Status
  RequestedAt
  CompletedAt
}

