  IsArchivedForParticipantOne
  IsArchivedForParticipantTwo
}
entity MESSAGE {
  Id <<key>>
  Body
  SentAt
  ReadAt
}
entity USER_BLOCK {
  Id <<key>>
  BlockedAt
