}

' ---------------------------------------------------------------------
' ZONE 5 — Resources Hub & Notifications
' ---------------------------------------------------------------------
entity "USER" as USER_RES {
  Id <<key>>
}
entity RESOURCE {
  Id <<key>>
  Slug
  TitleEn
  TitleAr
  Type
  Status
  AuthorRole
  IsFeatured
  PublishedAt
}
entity RESOURCE_CHAPTER {
  Id <<key>>
  TitleEn
  SortOrder
  EstimatedReadMinutes
}
entity RESOURCE_BOOKMARK {
  Id <<key>>
  BookmarkedAt
}
entity RESOURCE_PROGRESS {
  Id <<key>>
  ChaptersCompletedCount <<derived>>
  LastAccessedAt
}
entity RESOURCE_PROGRESS_CHILD {
  Id <<key>>
