' ── Inheritance ──────────────────────────────────────────────────────




' ── Associations (with multiplicities + roles) ───────────────────────
' Identity & Profile
UserProfile "1" *-- "*" EducationEntry : education >
UpgradeRequest "1" *-- "*" UpgradeRequestFile : files >
UpgradeRequest "1" *-- "*" UpgradeRequestLink : links >

' Scholarships & Applications
Scholarship "1" *-- "*" ScholarshipChild : details >
ApplicationTracker "1" *-- "*" ApplicationTrackerChild : history >

' Bookings & Ratings
ConsultantBooking "1" *-- "*" SessionRecording : recordedAs >

' Community & Chat
ForumPost "1" *-- "*" ForumPostAttachment : attaches >
ForumPost "1" *-- "*" ForumPostTag : postTags >
ForumTag "1" *-- "*" ForumPostTag : tagLinks >
ChatConversation "1" *-- "*" ChatMessage : messages >

' Resources & Notifications
Resource "1" *-- "*" ResourceChild : chapters >
ResourceProgress "1" *-- "*" ResourceProgressChild : perChapter >

' AI & Cross-cutting
AiInteraction ..> KnowledgeDocument : cites (RAG, via MetadataJson — no FK)
@enduml
