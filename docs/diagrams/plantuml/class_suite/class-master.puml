' =====================================================================
'  ScholarPath — UML Class Diagram (MASTER / full domain model)
'  Single @startuml covering all 6 domain modules, base types,
'  inheritance and key associations. Rendered on a large canvas —
'  no cropping (skinparam dpi 150 + PlantUML auto-layout).
'
'  Notation (matches class-diagrams.puml / class-clusters.puml):
'   * plain rectangle, three compartments (name / attributes / operations)
'   * "hide circle" drops the stereotype icon; empty members kept
'   * members are "name : Type", visibility  - private  + public  # protected
'   * derived members carry a leading '/'  ;  «enc» = encrypted-at-rest column
'   * generalization = hollow triangle, composition = filled diamond,
'     aggregation = hollow diamond, association = line + multiplicities + role
'   * ApplicationUser inherits IdentityUser<Guid> (NOT AuditableEntity) and
'     implements ISoftDeletable — see Class_Base_Types.
'
'  Truth source: server/src/ScholarPath.Domain/Entities/*.cs  +
'                Infrastructure/Migrations/ApplicationDbContextModelSnapshot.cs
'  Scope: PAYMENTS EXCLUDED by product decision (no Payment/Payout/
'         StripeWebhookEvent/ProfitShareConfig/FinancialConfigRule/
'         ScholarshipProviderReviewPayment, and no price/settlement columns).
' =====================================================================

@startuml ScholarPath_Class_Master
title ScholarPath — Domain Model (UML class diagram, full)
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 70
hide circle
hide members
skinparam linetype polyline
left to right direction
note as N1
  **Inheritance (uniform, omitted here for clarity):**
  every entity extends **AuditableEntity** (CreatedAt/UpdatedAt/RowVersion...) and
  implements **ISoftDeletable**; **ApplicationUser** extends IdentityUser<Guid>.
  Composition (filled diamond) = owner -> its weak child. Full members +
  inheritance are in the per-module class diagrams.
end note


' ── Base types (shown once) ──────────────────────────────────────────
abstract class BaseEntity {
  -Id : Guid
  +DomainEvents : IReadOnlyCollection<DomainEvent>
  +RaiseDomainEvent(e) : void
  +ClearDomainEvents() : void
}
abstract class AuditableEntity {
  -CreatedAt : DateTimeOffset
  -CreatedByUserId : Guid?
  -UpdatedAt : DateTimeOffset?
  -UpdatedByUserId : Guid?
  -RowVersion : byte[]?
}
interface ISoftDeletable {
  +IsDeleted : bool
  +DeletedAt : DateTimeOffset?
  +DeletedByUserId : Guid?
}
class "IdentityUser<Guid>" as IdentityUser <<ASP.NET Identity>>
class "IdentityRole<Guid>" as IdentityRole <<ASP.NET Identity>>

' =====================================================================
'  MODULE 1 — Identity & Profile  (PB-001/002/010)
' =====================================================================
package "1 · Identity & Profile" {
  class ApplicationUser <<identity + ISoftDeletable>> {
    -Email : string
    -FirstName : string
    -LastName : string
    -ProfileImageUrl : string?
    -AccountStatus : AccountStatus
    -ActiveRole : string?
    -IsOnboardingComplete : bool
    -PreferredLanguage : string?
    -CountryOfResidence : string?
    -LastLoginAt : DateTimeOffset?
    +/FullName : string
  }
  class ApplicationRole <<: IdentityRole<Guid>>> {
    -Name : string
    -Description : string?
  }
  class UserProfile {
    -Biography : string? «enc»
    -BiographyAr : string?
    -Gpa : decimal?
    -AcademicLevel : AcademicLevel?
    -FieldOfStudy : string?
    -BookingAccessStatus : BookingAccessStatus
    -BookingBlockReason : BookingBlockReason?
    -BookingBlockUntil : DateTimeOffset?
    -OrganizationLegalName : string?
    -OrganizationVerificationStatus : string?
    -ScholarshipProviderAverageRating : decimal?
    -ScholarshipProviderReviewCount : int
    -ScholarshipProviderLowRatingFlaggedAt : DateTimeOffset?
    -ProfessionalTitle : string?
    -SessionDurationMinutes : int?
    -BookingIntakeSuspendedAt : DateTimeOffset?
    -ConsultantAverageRating : decimal?
    -ConsultantReviewCount : int
    -ConsultantLowRatingFlaggedAt : DateTimeOffset?
    -ConsultantRatingPenaltyFactor : decimal
    -ProfileCompletenessPercent : int?
  }
  class EducationEntry {
    -InstitutionName : string
    -Degree : string
    -FieldOfStudy : string
    -Gpa : decimal?
  }
  class ExpertiseTag <<lookup : BaseEntity>> {
    -NameEn : string
    -NameAr : string
    -Slug : string
    -Category : string?
  }
  class RefreshToken {
    -TokenHash : string
    -ExpiresAt : DateTimeOffset
    -IsRevoked : bool
  }
  class PasswordResetToken {
    -TokenHash : string
    -ExpiresAt : DateTimeOffset
    -UsedAt : DateTimeOffset?
  }
  class LoginAttempt <<: BaseEntity>> {
    -Email : string
    -Succeeded : bool
    -OccurredAt : DateTimeOffset
  }
  class UpgradeRequest {
    -Target : UpgradeTarget
    -Status : UpgradeRequestStatus
    -Reason : string?
  }
  class UpgradeRequestFile <<: BaseEntity>> {
    -FileName : string
    -BlobUrl : string
  }
  class UpgradeRequestLink <<: BaseEntity>> {
    -Label : string
    -Url : string
  }
}

